{
  "name": "laser-tenders-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4123",
    "build": "next build",
    "start": "next start --port 4173",
    "build-start": "npx prisma generate && npm run build && next start --port 4173",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "sync:costing": "node scripts/syncExternalCosting.mjs",
    "scan:costing-files": "node scripts/scanCostingFiles.mjs",
    "backfill:contracts": "node scripts/backfillContractFromXls.mjs",
    "backfill:contracts:dry": "node scripts/backfillContractFromXls.mjs --dry-run",
    "allocate:tenders": "node scripts/allocateTenders.mjs",
    "allocate:tenders:dry": "node scripts/allocateTenders.mjs --dry-run",
    "check:docket-fy": "node scripts/checkDocketFyMismatch.mjs",
    "test": "node --liftoff-only --import tsx --test --test-isolation=none costing/*.test.ts sync/*.test.ts lib/*.test.ts",
    "db:seed": "tsx sync/seed.ts",
    "sync:smartsheet": "node --liftoff-only --import tsx sync/smartsheet_sync.ts",
    "sync:gsheets": "tsx sync/gsheets_sync.ts",
    "sync:attachments": "tsx sync/attachments_sync.ts",
    "sync:mirror": "tsx sync/mirror_to_smartsheet.ts",
    "parity": "tsx sync/parity_check.ts",
    "costing:parity": "tsx costing/parity.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "amqplib": "^2.0.1",
    "next": "^15.1.6",
    "next-auth": "^4.24.15",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
