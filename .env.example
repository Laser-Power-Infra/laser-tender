# NextAuth (v4)
NEXTAUTH_SECRET=""        # openssl rand -base64 32
NEXTAUTH_URL=""           # e.g. http://localhost:4123

# Set to "true" only when the app is served over https (Secure cookie). Leave unset on plain http.
AUTH_COOKIE_SECURE=""

# Google sign-in (optional: button is hidden when AUTH_GOOGLE_ID is unset)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
